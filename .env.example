# Placeholders only. Never commit real values. Deploys use a Foundry keystore (--account), not a raw key.
ARC_RPC=https://rpc.mainnet.arc.io
# Set to true to run read-only fork tests against the real ArcDraw coordinator.
ARC_FORK_TESTS=false

# Web app (apps/web), build time. All optional: defaults come from deployments/arc-mainnet.json (Arc mainnet).
# An empty/zero ArcPet address makes the app show "not deployed yet".
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ARCPET_ADDRESS=
NEXT_PUBLIC_COORDINATOR_ADDRESS=
